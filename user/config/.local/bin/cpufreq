#!/bin/bash

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <max_frequency_in_GHz>"
    exit 1
fi

MAX_FREQ="$1"

if ! [[ "$MAX_FREQ" =~ ^[0-9]+\.?[0-9]+?$ ]]; then
    echo "Error: frequency must be a number in GHz."
    exit 1
fi

read -r MIN_KHZ MAX_KHZ < <(
    cpupower frequency-info -l |
    awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { print $1, $2; exit }'
)

if [ -z "$MIN_KHZ" ] || [ -z "$MAX_KHZ" ]; then
    echo "Error: could not determine CPU frequency limits."
    exit 1
fi

MIN=$(awk -v f="$MIN_KHZ" 'BEGIN { printf "%.3f", f / 1000000 }')
MAX=$(awk -v f="$MAX_KHZ" 'BEGIN { printf "%.3f", f / 1000000 }')

if awk -v freq="$MAX_FREQ" -v min="$MIN" -v max="$MAX" \
    'BEGIN { exit !(freq < min || freq > max) }'
then
    echo "WARNING: Frequency out of range."
    echo "Hardware supports between $MIN GHz - $MAX GHz"
fi

echo "Setting maximum frequency to ${MAX_FREQ} GHz"
sudo cpupower frequency-set -g ondemand -u "${MAX_FREQ}GHz"
