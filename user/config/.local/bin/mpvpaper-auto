#!/bin/sh

if [[ -z "$1" || "$1" == "-h" ]]; then
	echo "Usage: $(basename "$0") <wallpaper>"
	echo "Searches ~/Pictures/wallpapers/<wallpaper>[.*]"
	exit 0
fi

wallpaper="$1"

if [[ "$wallpaper" != */* ]]; then
	wallpaper="$HOME/Pictures/wallpapers/$wallpaper"
fi

if [[ -f "$wallpaper" ]]; then
	file="$wallpaper"
else
	files=( "$wallpaper".* )
	[[ -f "${files[0]}" ]] && file="${files[0]}" || exit 1
fi

exec mpvpaper -s ALL "$file" \
	-o "mute loop load-scripts=no hwdec=vaapi profile=fast \
		cache=yes demuxer-max-bytes=16MiB demuxer-max-back-bytes=16MiB really-quiet=yes"
